# Environment configuration template for Policy Ingestion Service.
# Copy this file to .env and populate with actual deployment values.

ENVIRONMENT=development
PORT=8080
LOG_LEVEL=info

# Database Configuration (Aiven PostgreSQL with pgvector)
# Can specify individual parameters or full DATABASE_URL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=policy_db
DB_USER=postgres
DB_PASSWORD=your-database-password-here
DB_SSL=disable

# Full asyncpg DSN alternative:
# DATABASE_URL=postgresql://user:password@host:5432/policy_db?sslmode=disable

# Google Drive OAuth 2.0 Credentials (drive.readonly scope)
POLICY_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
POLICY_GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
POLICY_GOOGLE_OAUTH_REFRESH_TOKEN=your-google-oauth-refresh-token

# Google Drive Target Folders
POLICY_DRIVE_FOLDER_ID=your-hr-policy-drive-folder-id
TRAINING_DRIVE_FOLDER_ID=your-training-playbook-drive-folder-id

# Vector Embeddings (Local ONNX CPU with FastEmbed - 0 external API keys required)
# Options: "local" (BAAI/bge-base-en-v1.5) or "dummy" (deterministic hash mock)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768

# Ingestion Sync Scheduling
SYNC_ENABLED=true
POLICY_SYNC_INTERVAL_HOURS=24
SYNC_ON_STARTUP=true

# Chunking Hyperparameters
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
