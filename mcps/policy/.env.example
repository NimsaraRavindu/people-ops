# Environment configuration template for Policy MCP Server (Go).
# Copy this file to .env and populate with deployment values.

PORT=8003
ENV=development
DEV_MOCK_USER_ENABLED=false
DEV_MOCK_EMAIL=user@example.com

# Database Configuration (PostgreSQL with pgvector)
# Shares the same pgvector database populated by policy-ingestion service
DB_HOST=localhost
DB_PORT=5432
DB_NAME=policy_db
DB_USER=postgres
DB_PASSWORD=your-database-password-here
DB_SSL=disable

# Google Drive Folder IDs (used to filter query_policy vs query_training)
POLICY_DRIVE_FOLDER_ID=your-hr-policy-drive-folder-id
TRAINING_DRIVE_FOLDER_ID=your-training-playbook-drive-folder-id

# Embedding Configuration
# Calls the local policy-ingestion service /embed endpoint (runs FastEmbed ONNX locally)
POLICY_INGESTION_URL=http://localhost:8080

# Token Verification (Choreo API Gateway assertion; Asgardeo validation is handled by Choreo)
TOKEN_VALIDATOR_ENABLED=false
CHOREO_JWKS_URL=https://gateway.api.choreo.dev/.wellknown/jwks
