# Server Port
PORT=8080

# Leave Backend URL (Leave management, holidays, employee calendar)
LEAVE_BACKEND_URL=http://localhost:9090

# People Backend URL (Employee profile, work location, campus vehicles)
PEOPLE_BACKEND_URL=https://<choreo-gateway-url>/people-ops-suite/people-app-backend/v1.0

# Meals Backend URL (Cafeteria daily menu, lunch ratings)
MENU_BACKEND_URL=https://<choreo-gateway-url>/people-ops-suite/meals-app-backend/v1.0

# Subscriptions Backend URL (Lunch as a Service, PickMe Commute)
SUBSCRIPTION_BACKEND_URL=https://<choreo-gateway-url>/rvtw/subscription-app-backend/v1.0

# Letter Request Form URL
LETTER_REQUEST_FORM_URL=https://forms.gle/official-po-letter-request-form
